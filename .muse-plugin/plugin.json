{
  "schemaVersion": 1,
  "name": "oz-docs",
  "version": "1.0.1",
  "displayName": "Oz Docs",
  "description": "Write and revise Markdown documents, return to them by name, and publish finished pages.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "write-doc",
        "path": "skills/write-doc/SKILL.md"
      },
      {
        "id": "publish-page",
        "path": "skills/publish-page/SKILL.md"
      },
      {
        "id": "work-in-editor",
        "path": "skills/work-in-editor/SKILL.md"
      },
      {
        "id": "manage-attachments",
        "path": "skills/manage-attachments/SKILL.md"
      }
    ],
    "mcpServers": []
  }
}
